{
  "name": "skillexchange-unified-test-suite",
  "version": "2.0.0",
  "description": "Unified Quality Assurance & Performance Test Suite for SkillExchange AI (Web Selenium, Android Appium, and Baseline Load Testing with Excel Analysis)",
  "main": "run-all-tests.js",
  "type": "commonjs",
  "scripts": {
    "test": "node run-all-tests.js",
    "test:all": "node run-all-tests.js",
