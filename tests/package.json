    "selenium-webdriver": "^4.27.0",
    "chromedriver": "^132.0.0",
    "webdriverio": "^8.36.1",
    "appium": "^2.11.3",
    "mocha": "^11.1.0",
    "chai": "^4.5.0",
    "exceljs": "^4.4.0"
  }
}

